{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "production": { "type": "boolean" },
    "secrets": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string", "minLength": 1 },
        "data": {
          "type": "object",
          "properties": {
            "adminPassword": { "type": "string" },
            "mysqlPassword": { "type": "string" },
            "mysqlRootPassword": { "type": "string" }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    },
    "httpRoute": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    },
    "platform": {
      "type": "object",
      "properties": {
        "kubernetes": {
          "type": "object",
          "required": ["enabled", "baseUrl", "tokenExpirationSeconds"],
          "properties": {
            "enabled": { "type": "boolean" },
            "baseUrl": { "type": "string", "pattern": "^https://" },
            "deepLinkUrl": { "type": "string" },
            "timeoutMs": { "type": "integer", "minimum": 500, "maximum": 10000 },
            "maxResponseBytes": { "type": "integer", "minimum": 65536, "maximum": 2097152 },
            "tokenExpirationSeconds": { "type": "integer", "minimum": 600, "maximum": 3600 }
          }
        },
        "integrations": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["enabled", "baseUrl", "timeoutMs", "maxResponseBytes"],
            "properties": {
              "enabled": { "type": "boolean" },
              "baseUrl": { "type": "string" },
              "deepLinkUrl": { "type": "string" },
              "timeoutMs": { "type": "integer", "minimum": 500, "maximum": 10000 },
              "maxResponseBytes": { "type": "integer", "minimum": 65536, "maximum": 2097152 },
              "existingSecret": { "type": "string" },
              "bearerTokenKey": { "type": "string" },
              "usernameKey": { "type": "string" },
              "passwordKey": { "type": "string" }
            }
          }
        }
      }
    },
    "monitoring": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "interval": { "type": "string", "pattern": "^[1-9][0-9]*(s|m|h)$" }
          }
        },
        "grafana": {
          "type": "object",
          "properties": {
            "sidecarLabel": { "type": "string", "minLength": 1 },
            "sidecarLabelValue": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "allowInternetEgress": { "type": "boolean" },
        "externalDatabase": {
          "type": "object",
          "properties": {
            "cidr": { "type": "string" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "integrationEgress": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "cidr", "port"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "cidr": { "type": "string", "minLength": 3 },
              "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "not": {
        "properties": {
          "ingress": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
          "httpRoute": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] }
        },
        "required": ["ingress", "httpRoute"]
      }
    },
    {
      "if": { "properties": { "production": { "const": true } }, "required": ["production"] },
      "then": {
        "properties": {
          "secrets": {
            "properties": {
              "create": { "const": false },
              "data": {
                "properties": {
                  "adminPassword": { "maxLength": 0 },
                  "mysqlPassword": { "maxLength": 0 },
                  "mysqlRootPassword": { "maxLength": 0 }
                }
              }
            }
          }
        }
      }
    }
  ]
}
