LIFEOPS_STORE=mysql
HOST=0.0.0.0
PORT=8080
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=lifeops
MYSQL_USER=lifeops
MYSQL_PASSWORD=replace-with-a-secret
MYSQL_CONNECTION_LIMIT=10
LIFEOPS_ADMIN_ACCOUNT=owner@example.com
LIFEOPS_ADMIN_PASSWORD=replace-with-at-least-12-characters
LIFEOPS_ADMIN_DISPLAY_NAME=LifeOps Owner
LIFEOPS_SESSION_TTL_SECONDS=28800
LIFEOPS_COOKIE_NAME=lifeops_session
LIFEOPS_SECURE_COOKIES=false
LIFEOPS_ALLOWED_ORIGINS=http://localhost:5173
LIFEOPS_LOGGER=true
# Comma-separated trusted proxy CIDRs. Leave empty unless the gateway network is known.
LIFEOPS_TRUST_PROXY=
